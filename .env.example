# Personal API Token from app.admrl.co → Settings → API Tokens
# The secret is shown only once when the token is created.
ADMRL_API_TOKEN_ID=
ADMRL_API_SECRET_KEY=

# Optional. If unset, tools that need an org will list organisations
# and use the only one, or ask you to pick.
ADMRL_ORG_ID=

# Optional override (default https://api.admrl.co/v1)
# ADMRL_API_BASE=https://api.admrl.co/v1
